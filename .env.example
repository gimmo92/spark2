# Copy to .env.local for local development (or run: vercel env pull .env.local)

# Set automatically by the Vercel <-> Supabase integration
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server only, used by /api/auth/register

# Random string, at least 32 characters (e.g. `openssl rand -base64 48`). Signs the 2-step login cookie.
AUTH_SECRET=<random-32+-chars>

# Turn the login gate on (pages redirect to /login without password + email code)
AUTH_ENABLED=true
