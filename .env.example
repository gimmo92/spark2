# Copy to .env.local for local development (or run: vercel env pull .env.local)

# Set automatically by the Vercel <-> Supabase integration
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Turn the login gate on (pages redirect to /login without a session)
AUTH_ENABLED=true

# Login methods shown on /login: any of password,otp,sso,azure,google (default: password,otp)
NEXT_PUBLIC_AUTH_METHODS=password,otp

# Optional: only these email domains may sign in (comma separated)
ALLOWED_EMAIL_DOMAINS=tryspark.co
