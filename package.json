{
  "name": "spark",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @spark/demo",
    "dev:gavazzi": "npm run dev -w @spark/carlo-gavazzi",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
