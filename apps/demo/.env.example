# Copy to .env.local for local development (or run: vercel env pull .env.local)

# Set automatically by the Vercel <-> Supabase integration
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server only: invites + registration

# Random string, at least 32 characters (e.g. `openssl rand -base64 48`). Signs the 2-step login cookie.
AUTH_SECRET=<random-32+-chars>

# Login gate: always on (pages redirect to /login without password + email code)
# AUTH_ENABLED=false  # only to switch the login gate off (it is on by default)

# SendGrid: every email (invites, login codes, password reset) is sent by the core. No SMTP/templates in Supabase.
SENDGRID_API_KEY=<sendgrid-api-key>
SENDGRID_FROM=noreply@tryspark.co
SENDGRID_FROM_NAME=Spark

# Admins (comma separated): can log in without an invite (the first admin is created by hand in Supabase)
# and are the only ones allowed to send invites. Empty = any signed-in user can send invites.
ADMIN_EMAILS=

# Spark staff (comma separated): Pannello Spark (/spark), modules on/off and, in multi-tenant apps, the
# companies. Optional: when empty, ADMIN_EMAILS are the staff. Set it only if ADMIN_EMAILS lists the client's admins.
# SPARK_STAFF_EMAILS=
